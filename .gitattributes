# Detect text files automatically unless a more specific rule applies.
* text=auto

# Treat source code and documentation consistently across platforms.
*.m text eol=lf
*.mlx binary
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# MATLAB/Simulink and scientific data source assets are retained as binary files.
*.slx binary
*.mdl binary
*.sldd binary
*.mat binary
*.mldatx binary
*.slxp binary
*.mdlp binary
*.mlapp binary
*.fig binary
*.p binary
*.mex* binary

# Preserve generated propulsion CSV bytes so the recorded reproduction compares exactly.
platform/parameters/aircraft/v0.1/propulsion_requirements.csv text eol=crlf

# A-V3-05AD hashes are over checkout bytes. Preserve source and generated CSV verbatim.
platform/parameters/propeller/v0.1/** text eol=lf
platform/parameters/propeller/v0.1/**/*.csv -text !eol whitespace=cr-at-eol
platform/parameters/propeller/v0.1/**/*.png binary !eol
platform/parameters/propeller/v0.1/**/*.zip binary !eol
# These historical Markdown files use two spaces for hard line breaks.
platform/parameters/propeller/v0.1/calculations/original/replayed-package/README.md whitespace=-blank-at-eol
platform/parameters/propeller/v0.1/calculations/original/replayed-package/propeller_design_report.md whitespace=-blank-at-eol
