# Treat text sources and documentation consistently across platforms.
*.m text eol=lf
*.mlx binary
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# MATLAB/Simulink and scientific data source assets are retained as binary files.
*.slx binary
*.mdl binary
*.sldd binary
*.mat binary
*.p binary
*.mex* binary
