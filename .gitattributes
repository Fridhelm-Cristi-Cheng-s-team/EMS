# Detect text files automatically unless a more specific rule applies.
* text=auto

# Treat source code and documentation consistently across platforms.
*.m text eol=lf
*.mlx binary
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# MATLAB/Simulink and scientific data source assets are retained as binary files.
*.slx binary
*.mdl binary
*.sldd binary
*.mat binary
*.mldatx binary
*.slxp binary
*.mdlp binary
*.mlapp binary
*.fig binary
*.p binary
*.mex* binary

# Preserve generated propulsion CSV bytes so the recorded reproduction compares exactly.
platform/parameters/aircraft/v0.1/propulsion_requirements.csv text eol=crlf

# Preserve archival source and replay CSV bytes for the propeller baseline.
platform/parameters/propeller/v0.1/calculations/original/**/*.csv text eol=crlf
platform/parameters/propeller/v0.1/calculations/original/**/inputs/*.csv text eol=crlf
platform/parameters/propeller/v0.1/calculations/revised/*.csv text eol=crlf
